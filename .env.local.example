# Supabase 프로젝트 설정 > API Keys 메뉴에서 값을 복사해 .env.local 파일을 만드세요.
# (publishable 키 - sb_publishable_... 로 시작, 예전 이름은 anon public 키)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx

# 마이그레이션 스크립트(scripts/migrate-from-export.mjs) 전용 - secret 키(sb_secret_... 로 시작,
# 예전 이름은 service_role 키)를 넣으세요. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고, 브라우저/클라이언트
# 코드에서 쓰지 마세요.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# PIN 2차 보안 쿠키 서명용 비밀값 - 무작위 문자열로 직접 만들어 채우세요.
# (예: openssl rand -hex 32 명령으로 생성)
PIN_COOKIE_SECRET=xxxxxxxx

# AI 제안 워크플로우(사건/행사/회의 분석)에 사용하는 Anthropic API 키. 서버(API 라우트)에서만 쓰이고
# 브라우저에는 절대 노출되지 않습니다.
ANTHROPIC_API_KEY=xxxxxxxx

# 학기 자동 전환용 Vercel Cron 인증값(무작위 문자열로 직접 만들어 채우세요, 예: openssl rand -hex 32).
# Vercel 프로젝트의 Settings > Environment Variables에도 같은 값으로 CRON_SECRET을 추가해야
# /api/cron/term-switch가 매일 정상 동작합니다(vercel.json 참고).
CRON_SECRET=xxxxxxxx

# 안내보드에서 유튜브를 직접 검색할 때 씁니다(요청: "크롬창을 작게 가져와서 자유롭게 서치
# 해서 클릭할 수 있게"). 발급 방법: https://console.cloud.google.com 접속 > 프로젝트 만들기(또는
# 기존 프로젝트 선택) > 왼쪽 메뉴 "API 및 서비스" > "라이브러리"에서 "YouTube Data API v3" 검색 후
# 사용 설정 > "사용자 인증 정보" > "+ 사용자 인증 정보 만들기" > "API 키". 무료이고, 하루 검색
# 가능 횟수(할당량)도 넉넉합니다. 서버(API 라우트)에서만 쓰이고 브라우저에는 노출되지 않습니다.
# Vercel 프로젝트의 Settings > Environment Variables에도 같은 값으로 YOUTUBE_API_KEY를 추가해야
# 배포된 안내보드에서도 검색이 됩니다.
YOUTUBE_API_KEY=xxxxxxxx
